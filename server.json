{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Thewhey-Brian/hotedit",
  "title": "hotedit",
  "description": "Open an HTML report in the user's browser and edit it live while they watch; they can edit it by hand too.",
  "repository": { "url": "https://github.com/Thewhey-Brian/hotedit", "source": "github" },
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "hotedit",
      "version": "0.5.0",
      "runtimeHint": "npx",
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "transport": { "type": "stdio" }
    }
  ]
}
